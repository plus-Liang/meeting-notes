# ============================================================================
# MeetingNotes 全量配置模板 —— 复制为 .env 后按需修改
# 规则：任何配置都必须能从这里覆盖；代码里不允许出现硬编码的路径/端口/key/并发数/模型名
# 原则：不填任何 key 也能完整跑通（N15 / D-020 三档 AI 降级）
# ============================================================================

# ---------- 应用 ----------
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
# 宿主端口（只在宿主机生效，容器内端口固定）：
# 端口冲突时改这里；.env 里没写的键用 compose 默认值（下面三个默认值即 compose 默认值）
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
OLLAMA_PORT=11434
# 第三方镜像加速前缀（docker compose / Dockerfile build arg 共用）。
# 留空 = 直连 Docker Hub；国内网络建议 docker.m.daocloud.io/（注意结尾带斜杠）
REGISTRY_PREFIX=
# daocloud 等加速源对非 library 镜像（minio/ollama）白名单拒绝，可整体覆盖来源：
# MINIO_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/minio/minio:latest
# OLLAMA_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/ollama/ollama:latest
MINIO_IMAGE=
OLLAMA_IMAGE=
# 单任务硬上限（spec §4）
# D-028：时长上限 30→60 分钟（真实库 45% 文件超 30 分钟），可配至 120 分钟
TASK_MAX_DURATION_SEC=3600
TASK_MAX_SIZE_BYTES=209715200
TASK_MAX_RETRIES=3
# 批量提交（T4.7/US-8，需求确认单 D2）：一次最多 20 个文件；请求总体积上限 2GB（单文件仍受 TASK_MAX_SIZE_BYTES）；
# 预估耗时系数（estimated_sec = round(总时长*系数 + 受理项*2)，只是预估不承诺）
BATCH_MAX_FILES=20
TASK_BATCH_MAX_SIZE_BYTES=2147483648
BATCH_ESTIMATE_RTF=0.15
# 时长探测工具（容器内已装；容器外本地跑测试时才需要指到本机 ffmpeg 的 ffprobe）
FFPROBE_BIN=ffprobe
# worker 抽音轨用的 ffmpeg（容器内已装）
FFMPEG_BIN=ffmpeg
# Redis 任务队列（T1.5 worker：LPUSH 生产 / BLPOP 消费）
TASK_QUEUE_KEY=meetingnotes:task-queue
WORKER_POLL_TIMEOUT_SEC=10

# ---------- 数据库 ----------
POSTGRES_DB=meetingnotes
POSTGRES_USER=mn
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://postgres:5432/meetingnotes
DB_USER=mn
DB_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 对象存储（MinIO / S3）----------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=meetingnotes
S3_REGION=us-east-1
S3_PATH_STYLE=true

# ---------- ASR 服务（自建，OpenAI 兼容；零成本、可离线）----------
# 镜像在本地构建（infra/asr），不依赖 Docker Hub
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Spring AI 内部重试（收敛到 2 次快速失败，重试语义交给 worker 的 RETRYING 状态机）
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_BACKOFF_INITIAL_MS=2000
AI_RETRY_BACKOFF_MAX_MS=10000
# ASR 连接/首字节超时（T2.2/D-058：停 ASR 时快速失败）；单次转写总超时用 ASR_TIMEOUT_SEC
ASR_CONNECT_TIMEOUT_SEC=5
# 时区（T3.0/D-067：配额日切按本地时区；海外用户可设 UTC；app 与 postgres 共用）
TZ=Asia/Shanghai
# LLM 摘要读超时（T3.1/D-068：按 URI 路由，与转写 900s 互不串）
LLM_TIMEOUT_SEC=120
ASR_PORT=8000
ASR_MODEL_NAME=small
ASR_LANGUAGE=zh
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=1
# 宿主机模型缓存目录（faster-whisper 的 HF 缓存根目录），默认仓库根 ./models
# 首次运行需下载模型：scripts/download-model.ps1（small≈461MB）；国内可设 HF_ENDPOINT=https://hf-mirror.com
ASR_MODEL_HOST_DIR=./models
# Spring AI 1.x 会自己追加 /v1/audio/transcriptions，故 base-url 不带 /v1；
# 容器内实际请求 = http://asr:8000/v1/audio/transcriptions
# 本机跑 AsrSmokeTest 时改成宿主机映射端口，例如 http://localhost:8001
ASR_BASE_URL=http://asr:8000
ASR_MODEL=small
ASR_API_KEY=not-needed
ASR_RESPONSE_FORMAT=json
ASR_MAX_CONCURRENCY=2
ASR_TIMEOUT_SEC=900
ASR_MAX_SEGMENT_SEC=120
# 仅 AsrSmokeTest 使用：本地真实音频绝对路径（不进 git；不设置则 test.ps1 跳过冒烟）
# ASR_SMOKE_AUDIO=/abs/path/to/probe.wav

# ---------- LLM 第一档：云 API（可选，最好用）----------
# T0.5 实测（2026-11-13，见 decisions.md D-007 备注）：
#   DeepSeek  base-url https://api.deepseek.com + /v1/chat/completions + deepseek-flash
#             GET /models 实测返回 deepseek-flash / deepseek-v4-pro；
#             POST /chat/completions 与 /v1/chat/completions 均实测 200
#   智谱      base-url https://open.bigmodel.cn/api/paas/v4 + /chat/completions + glm-4.7-flash（免费）
#             智谱路径与 OpenAI 不同，换成智谱时 LLM_CHAT_COMPLETIONS_PATH 必须改成 /chat/completions
#   Kimi / 通义 URL 只作参考，未实测，不写默认值
# Spring AI 1.1.x 的 chat.completions-path 默认 /v1/chat/completions，由下面的变量覆盖
LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
# deepseek-flash 默认开启 thinking，max-tokens 太小会让 content 为空
LLM_MAX_TOKENS=8192
# 云档采样温度（T4.16b/D-107：固定 0.0 保证同内容结果可复现；要多样性时再调高）
LLM_TEMPERATURE=0.0
# 转写 AI 加标点长度上限（字，T4.18/D-109）：transcript 非空且 ≤ 此值才追加独立标点调用；
# 0 = 关闭标点；超限/失败 → 详情 transcript_punctuated 为 null（回退原始转写），任务不受影响
LLM_PUNCTUATE_MAX_CHARS=6000
# 空 = 自动（填了 LLM_API_KEY + LLM_BASE_URL + LLM_MODEL 即启用，D-035）；true/false 强制开关
LLM_ENABLED=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------- LLM 第二档：本地 Ollama（可选，免费但要内存）----------
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=
# T3.11/D-081：本地档独立预算（只影响 LOCAL 档；云档 LLM_MAX_TOKENS=8192 / LLM_TIMEOUT_SEC=120 不变）
LLM_LOCAL_MAX_TOKENS=512
LLM_LOCAL_TIMEOUT_SEC=180

# ---------- LLM 第三档：抽取式摘要（默认兜底，零依赖）----------
# true = 不调用任何 LLM，用关键句抽取 + 规则化待办抽取
EXTRACTIVE_FALLBACK_ENABLED=true

# ---------- 认证与配额 ----------
API_TOKEN=change-me-api-token
# T4.37a：开放注册开关（false → 注册接口 403 REGISTRATION_DISABLED；首次注册认领管理员不受限）
AUTH_REGISTRATION_ENABLED=true
QUOTA_MINUTES_PER_DAY=120
QUOTA_TASKS_PER_DAY=50

# ---------- 只读分享（T4.28）----------
# 分享链接有效期（天）；token 明文只在创建响应里出现一次，DB 只存 SHA256
SHARE_TTL_DAYS=7

# ---------- 播放器音频流（T4.35b，接入指南 §3.10）----------
# 短时签名音频 URL 有效期（秒）；签名 = HMAC-SHA256(key=API_TOKEN, taskId+"\n"+exp)，绑定 taskId+exp
# URL 可分享但只读、短时；GET /tasks/{id}/audio 免 Bearer 只认签名
AUDIO_TOKEN_TTL_SEC=600

# ---------- Webhook（供他人接入自己系统）----------
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_MAX_RETRIES=3
WEBHOOK_TIMEOUT_SEC=10

# ---------- 集成：inbox 目录监控（P2，NAS/笔记用户）----------
INBOX_ENABLED=false
INBOX_HOST_DIR=./inbox
INBOX_POLL_SEC=30

# ---------- 离线模式（B 类用户：数据不能出门）----------
# true = 禁止一切出站网络，仅用本地 ASR + 本地/抽取式摘要
OFFLINE_MODE=true

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_JSON=true

# ---------- 链接导入（T4.32a FETCH 直链，接入指南 §3.9）----------
# 重定向上限（每跳都做 SSRF 校验，超上限 400 URL_BLOCKED）
FETCH_MAX_REDIRECTS=5
# 连接/读超时（毫秒）
FETCH_CONNECT_TIMEOUT_MS=5000
FETCH_READ_TIMEOUT_MS=10000
# 单次下载大小上限（字节），超限 413 SIZE_EXCEEDED
FETCH_MAX_BYTES=209715200
# 逗号分隔主机白名单：命中则跳过内网 IP 拦截（SSRF 防护被绕过！）——仅自测/受信内网部署，生产必须留空
FETCH_ALLOW_HOSTS=
# ---------- 链接预览 + BYOF（T4.32b，接入指南 §3.9）----------
# 预览只读响应体前 N 字节（解析 og 元信息用，不整页进内存）
FETCH_PREVIEW_MAX_BYTES=2097152
# BYOF 外部抓取工具命令（默认空=未配置；use_byof 请求 → 400 FETCHER_UNAVAILABLE）。
# 按空格拆 argv 不过 shell；{url} 必填（独立元素，如 yt-dlp 之类由使用者自装、自负合规责任）；{out} 可选（无则读 stdout 落盘）
# 例：FETCHER_CMD=my-downloader --output {out} {url}
FETCHER_CMD=
# 外部工具超时（毫秒），超时/非 0 退出 → 502 FETCH_FAILED
FETCHER_TIMEOUT_MS=120000
