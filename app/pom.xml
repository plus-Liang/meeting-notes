<?xml version="1.0" encoding="UTF-8"?>
<!--
  版本已于 2026-11-13 在 Maven Central 官方 metadata + starter POM 核对（非教程抄写）：
    spring-boot-starter-parent 3.5.16  = 当前 3.5.x 最新 GA（AGENT.md 要求 Spring Boot 3）
    spring-ai-bom              1.1.8   = 当前 1.x 最新 GA；其 starter 依赖 spring-boot-starter 3.5.15，
                                         并首次提供 TranscriptionModel 接口；2.0.x 需要 Spring Boot 4，不采用
    artifact 名 spring-ai-starter-model-openai（1.0 GA 起的新名字，旧名已废弃）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.meetingnotes</groupId>
  <artifactId>meeting-notes</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>meeting-notes</name>
  <description>Self-hosted recording/course to structured minutes and TODOs</description>

  <properties>
    <java.version>21</java.version>
    <spring-ai.version>1.1.8</spring-ai.version>
    <!-- 2026-11-13 Maven Central 核对的最新 GA；Spring Boot 不管理 AWS SDK v2 -->
    <aws.sdk.version>2.59.0</aws.sdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web / 校验 / 健康检查 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 数据：JPA + Flyway + PG -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Redis -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 对象存储：S3 协议（MinIO 兼容） -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>

    <!-- AI：ChatModel + TranscriptionModel（OpenAI 兼容协议） -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>

    <!-- 工具 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 仅测试用：NoKeyStartupTest 不依赖外部 PostgreSQL，验证空 key 也能拉起完整上下文 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- T2.9 F-1：测试 JVM 关 JSON 日志（保持可读文本）+ 固定 UTF-8（治控制台中文乱码）。
           注意：不能用 src/test/resources/application.yml——它会遮蔽主配置文件，50 个测试全崩。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-DLOG_JSON=false -Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
